# ローカル開発用。必要な項目だけ .env にコピーしてください。.env はコミットしません。
# 保存済み Settings の値と ASR_* の適用箇所は README / worker_protocol.md を参照。
OPENAI_API_KEY=
GEMINI_API_KEY=
# ASR_UV=C:\path\to\uv.exe
# ASR_PYTHON=C:\path\to\python.exe
# ASR_WORKER_BACKEND=faster-whisper
# ASR_DEVICE=auto
# ASR_FASTER_WHISPER_MODEL=large-v3-turbo
# ASR_MODEL_ID=large-v3-turbo
# ASR_MAX_NEW_TOKENS=4096
# HF_TOKEN=
# HF_HOME=C:\path\to\model-cache
# ASR_API_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=
# ASR_API_TIMEOUT_SECONDS=300
# ASR_WORKER_PROGRESS=1
# ASR_QUANTIZATION=4bit
# ASR_SERVE_HOST=127.0.0.1
# ASR_SERVE_PORT=8000
# ASR_SERVE_API_KEY=
# ASR_SERVED_MODEL_NAME=local-asr
# LVI_USE_RELEASE_DATA=1
